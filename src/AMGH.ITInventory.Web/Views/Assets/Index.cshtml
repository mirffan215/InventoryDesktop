@model IEnumerable<AMGH.ITInventory.Domain.Entities.Asset>
@{ ViewData["Title"] = "Assets"; }
<div class="d-flex justify-content-between mb-3"><h2>Assets</h2>
  @if (User.IsInRole("Admin") || User.IsInRole("ITManager") || User.IsInRole("Technician")) { <a class="btn btn-primary" asp-action="Create">New asset</a> }</div>
<table id="assets" class="table table-striped table-sm w-100">
  <thead><tr><th>Tag</th><th>Name</th><th>Category</th><th>Serial</th><th>Location</th><th>Custodian</th><th>Status</th><th>Classification</th><th>Warranty</th><th>QR</th></tr></thead>
  <tbody>
  @foreach (var a in Model) {
    <tr><td>@a.AssetTag</td><td>@a.Name</td><td>@a.Category?.Name</td><td>@a.SerialNumber</td><td>@a.Location?.FullName</td><td>@a.Custodian?.DisplayName</td>
        <td>@a.Status</td><td>@a.Classification</td><td>@a.WarrantyEnd?.ToString("yyyy-MM-dd")</td><td><a asp-action="Qr" asp-route-id="@a.AssetTag" target="_blank">QR</a></td></tr>
  }
  </tbody>
</table>
@section Scripts { <script>$('#assets').DataTable({ pageLength: 25 });</script> }
