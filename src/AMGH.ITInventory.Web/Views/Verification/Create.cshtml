@model AMGH.ITInventory.Web.ViewModels.CampaignFormViewModel
@{ ViewData["Title"] = "New campaign"; }
<h2>New verification campaign</h2>
<form asp-action="Create" method="post" class="row g-3" style="max-width:700px">
  <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger"></span></div>
  <div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department Id (optional)</label><input asp-for="DepartmentId" class="form-control" /></div>
  <div class="col-md-6"><label asp-for="LocationId" class="form-label">Location Id (optional)</label><input asp-for="LocationId" class="form-control" /></div>
  <div class="col-12"><button class="btn btn-primary">Create draft</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
