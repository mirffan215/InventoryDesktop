<Window x:Class="AMGH.ITInventory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AMGH IT Inventory" Height="680" Width="1100"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox Width="160" materialDesign:HintAssist.Hint="User" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      <PasswordBox x:Name="Pwd" Width="160" materialDesign:HintAssist.Hint="Password" Margin="0,0,8,0"/>
      <Button Content="Sign in" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Pwd}" Margin="0,0,24,0"/>
      <Button Content="Sync now" Command="{Binding SyncCommand}" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBox Width="260" materialDesign:HintAssist.Hint="Scan or type asset tag, then Enter" Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding VerifyScanCommand}"/></TextBox.InputBindings>
      </TextBox>
      <ComboBox Width="260" Margin="12,0,0,0" ItemsSource="{Binding Campaigns}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCampaign}" materialDesign:HintAssist.Hint="Campaign"/>
      <TextBlock Text="{Binding PendingCount, StringFormat=Pending sync: {0}}" Margin="16,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <DataGrid ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tag" Binding="{Binding AssetTag}"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
        <DataGridTextColumn Header="Location" Binding="{Binding Location}"/>
        <DataGridTextColumn Header="Custodian" Binding="{Binding Custodian}"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
