<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AMGH.ITInventory.Mobile.Pages.LoginPage" Title="AMGH Asset Verify">
  <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
    <Label Text="AMGH IT Asset Verification" FontSize="22" HorizontalOptions="Center"/>
    <Entry Placeholder="User name" Text="{Binding UserName}"/>
    <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}"/>
    <Label Text="{Binding Error}" TextColor="Red"/>
    <Button Text="Sign in" Command="{Binding LoginCommand}"/>
    <ActivityIndicator IsRunning="{Binding Busy}"/>
  </VerticalStackLayout>
</ContentPage>
